{
  "name": "stable-frontend",
  "version": "1.0.0",
  "description": "Agent-native primitives and guardrails for robust frontend development",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "stable-frontend": "./bin/index.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "frontend",
    "stability",
    "guardrails",
    "validation"
  ],
  "author": "nithwin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nithwin/stable-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/Nithwin/stable-frontend/issues"
  },
  "homepage": "https://github.com/Nithwin/stable-frontend#readme",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
